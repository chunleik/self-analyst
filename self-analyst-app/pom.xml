<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.selfanalyst</groupId>
        <artifactId>self-analyst</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>self-analyst-app</artifactId>
    <packaging>jar</packaging>

    <name>SelfAnalyst :: App</name>
    <description>SelfAnalyst app — embedded AW server, LLM agent, desktop UI API</description>

    <dependencies>
        <dependency>
            <groupId>com.selfanalyst</groupId>
            <artifactId>self-analyst-aw</artifactId>
        </dependency>
        <dependency>
            <groupId>com.selfanalyst</groupId>
            <artifactId>self-analyst-content</artifactId>
        </dependency>
        <dependency>
            <groupId>com.selfanalyst</groupId>
            <artifactId>self-analyst-audio</artifactId>
        </dependency>
        <dependency>
            <groupId>com.selfanalyst</groupId>
            <artifactId>self-analyst-wiki</artifactId>
        </dependency>
        <dependency>
            <groupId>com.selfanalyst</groupId>
            <artifactId>self-analyst-file</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <!-- TOML v1.0 parser (position-aware errors). SPEC-TOML-DEC-007 -->
            <groupId>org.tomlj</groupId>
            <artifactId>tomlj</artifactId>
            <version>1.1.1</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.selfanalyst.App</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <filters>
                        <filter>
                            <artifact>*:*</artifact>
                            <excludes>
                                <exclude>META-INF/*.SF</exclude>
                                <exclude>META-INF/*.DSA</exclude>
                                <exclude>META-INF/*.RSA</exclude>
                            </excludes>
                        </filter>
                    </filters>
                    <transformers>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                            <mainClass>com.selfanalyst.App</mainClass>
                        </transformer>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                    </transformers>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>verify-shaded-imageio-services</id>
                        <phase>verify</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <delete dir="${project.build.directory}/shade-verification" quiet="true"/>
                                <unzip src="${project.build.directory}/${project.build.finalName}.jar"
                                       dest="${project.build.directory}/shade-verification">
                                    <patternset>
                                        <include name="META-INF/services/javax.imageio.spi.ImageReaderSpi"/>
                                    </patternset>
                                </unzip>
                                <loadfile property="imageio.services"
                                          srcFile="${project.build.directory}/shade-verification/META-INF/services/javax.imageio.spi.ImageReaderSpi"/>
                                <fail message="Shaded JAR lost an ImageIO ServiceLoader provider">
                                    <condition>
                                        <not>
                                            <and>
                                                <contains string="${imageio.services}" substring="com.github.jaiimageio.impl.plugins.tiff.TIFFImageReaderSpi"/>
                                                <contains string="${imageio.services}" substring="org.apache.pdfbox.jbig2.JBIG2ImageReaderSpi"/>
                                            </and>
                                        </not>
                                    </condition>
                                </fail>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
